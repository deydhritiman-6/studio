
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- TESTIMONIALS ---
    match /testimonials/{testimonialId} {
      // Public can submit new testimonials but they must be 'pending'
      allow create: if request.resource.data.status == 'pending';
      // Public can only read approved testimonials
      allow get, list: if resource.data.status == 'approved' || isAuthenticated();
      // Admins can do everything
      allow update, delete: if isAuthenticated();
    }

    // --- INSIDE ROSEBERRY / FACILITIES SHOWCASE ---
    match /facilities/{facilityId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /settings/{settingId} {
      allow get: if true; // Public can read settings for footer display
      allow list, write: if isAuthenticated();
    }

    // --- PRODUCTS & CATALOG ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /product-galleries/{galleryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // --- ORDERS & TRANSACTIONS ---
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isAuthenticated();
      allow delete: if false;
    }

    // --- QUOTATIONS ---
    match /quotations/{quotationId} {
      allow read, write: if isAuthenticated();
    }

    // --- ADMINISTRATIVE DATA ---
    match /customers/{customerId} { allow read, write: if isAuthenticated(); }
    match /inventory/{itemId} { allow read, write: if isAuthenticated(); }
    match /distributors/{distributorId} { allow read, write: if isAuthenticated(); }
    match /recipes/{recipeId} { allow read, write: if isAuthenticated(); }
    match /vendors/{vendorId} { allow read, write: if isAuthenticated(); }
    match /material-purchases/{purchaseId} { allow read, write: if isAuthenticated(); }
    match /costings/{costingId} { allow read, write: if isAuthenticated(); }

    // --- SYSTEM FALLBACK ---
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
