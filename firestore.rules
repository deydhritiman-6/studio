rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if the user is a hardcoded administrator
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email in ['deydhritiman@gmail.com', 'deyalankrit@gmail.com'];
    }

    // Check if the user is authenticated (including anonymous sessions for carts)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is authenticated via a permanent account (non-anonymous)
    function isPermanentUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // --- PUBLIC COLLECTIONS (Read: Public, Write: Admin) ---
    // These power the public-facing boutique and branding sections.

    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /product-galleries/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /occasions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /facilities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- PATRON STORIES (TESTIMONIALS) ---
    match /testimonials/{docId} {
      // Guests see approved stories; admins see all for moderation
      allow read: if resource.data.status == 'approved' || isAdmin();
      // Any authenticated patron can share an experience
      allow create: if isAuthenticated();
      // Moderation actions restricted to system admins
      allow update, delete: if isAdmin();
    }

    // --- INTERNAL WORKSPACE COLLECTIONS (Read/Write: Authenticated Staff/Admin) ---
    // These collections handle the daily operations of the chocolate studio.
    
    match /customers/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /distributors/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /ingredients/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /inventory/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /recipes/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /vendors/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /material-purchases/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /costings/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /quotations/{docId} {
      allow read, write: if isAuthenticated();
    }

    // --- ORDERS & INVOICING ---
    match /orders/{orderId} {
      // Patrons can create orders via checkout
      allow create: if isAuthenticated();
      // Staff can manage orders; patrons can track their own if identified
      allow read, update: if isAuthenticated();
      // Deletions are restricted to protect financial history
      allow delete: if isAdmin();
    }

    // --- USER IDENTITY MATRIX ---
    match /users/{userId} {
      // Users can manage their own artisan profile
      allow read, update: if request.auth.uid == userId || isAdmin();
      // Staff registration restricted to admins
      allow create, delete: if isAdmin();
    }

    // --- RESTRICTED SYSTEM COLLECTIONS (Admin Only) ---
    
    match /broadcasts/{docId} {
      allow read, write: if isAdmin();
    }

    match /seo/{docId} {
      allow read, write: if isAdmin();
    }

    // --- DEFAULT FALLBACK ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
