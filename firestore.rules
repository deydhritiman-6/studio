rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAdmin() {
      // Hardcoded admin emails for executive oversight
      return request.auth != null &&
              request.auth.token.email in ['deydhritiman@gmail.com', 'deyalankrit@gmail.com'];
    }

    function isAuthenticated() {
      // Required for prototype login flow which utilizes anonymous authentication for staff/admins
      return request.auth != null;
    }

    // --- PUBLIC COLLECTIONS (Patron Facing) ---
    match /products/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /product-galleries/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /occasions/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /facilities/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /siteContent/{docId} { allow read: if true; allow write: if isAdmin(); }

    // --- SITE CONFIGURATION ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- PATRON STORIES (Moderated Feedback) ---
    match /testimonials/{docId} {
        allow read: if resource.data.status == 'approved' || isAdmin();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
    }

    // --- USER-SPECIFIC & STAFF-MANAGED COLLECTIONS ---
    match /users/{userId} {
      allow read, update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create, delete: if isAdmin();
    }

    match /customers/{customerId} {
      // Individual patrons can access their own profile; only Staff/Admins can list all for management.
      allow get: if (request.auth != null && request.auth.uid == customerId) || isAdmin();
      allow list: if isAdmin();
      allow write: if (request.auth != null && request.auth.uid == customerId) || isAdmin();
    }

    match /orders/{orderId} {
      // Patrons create and track their own journeys; Staff manage the production floor.
      allow create: if isAuthenticated();
      allow get: if (request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid)) || isAdmin();
      allow list: if isAuthenticated();
      allow update: if (request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- INTERNAL ARTISAN OPERATIONS ---
    // These collections house the heart of Roseberry Ops and require authentication.
    match /quotations/{docId} { allow read, write: if isAuthenticated(); }
    match /vendors/{docId} { allow read, write: if isAuthenticated(); }
    match /ingredients/{docId} { allow read, write: if isAuthenticated(); }
    match /material-purchases/{docId} { allow read, write: if isAuthenticated(); }
    match /inventory/{docId} { allow read, write: if isAuthenticated(); }
    match /recipes/{docId} { allow read, write: if isAuthenticated(); }
    match /costings/{docId} { allow read, write: if isAuthenticated(); }
    match /distributors/{docId} { allow read, write: if isAuthenticated(); }

    // --- DEFAULT FALLBACK ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}