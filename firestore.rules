rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- PUBLIC-FACING DATA ---
    // These collections are readable by anyone, including unauthenticated visitors.
    match /occasions/{docId} {
      allow read: if true;
    }
    match /facilities/{docId} {
      allow read: if true;
    }
    
    // --- APP SETTINGS ---
    // General settings for the app, readable by anyone.
    // Writes should be restricted, perhaps to an admin role in the future.
    match /settings/{docId} {
        allow read: if true;
        allow write: if isAuthenticated(); // Only logged-in users can change settings
    }

    // --- USER-SPECIFIC DATA ---
    // A user can only read or write to their own document in the users collection.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // --- AUTHENTICATED-ONLY DATA ---
    // The following collections are part of your business operations and require 
    // a user to be logged in to read or write any data.
    
    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }
    
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated(); // For now, any user can see any order.
      allow delete: if false; // Prevent accidental deletion of orders.
    }
    
    match /customers/{customerId} { allow read, write: if isAuthenticated(); }
    match /inventory/{itemId} { allow read, write: if isAuthenticated(); }
    match /distributors/{distributorId} { allow read, write: if isAuthenticated(); }
    match /recipes/{recipeId} { allow read, write: if isAuthenticated(); }
    match /invoices/{invoiceId} { allow read, write: if isAuthenticated(); }
    match /testimonials/{testimonialId} { allow read, write: if isAuthenticated(); }

    // Any path not explicitly matched above is denied by default.
  }
}
