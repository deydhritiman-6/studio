
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- INSIDE ROSEBERRY / FACILITIES SHOWCASE ---
    // Public read access for the showcase content
    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Public read access for specific facilities settings
    match /settings/{settingId} {
      allow read: if settingId == 'facilities' || isAuthenticated();
      allow write: if isAuthenticated();
    }

    // --- PRODUCTS & CATALOG ---
    // Catalog visible to everyone (including anonymous guests)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Galleries: Visible to everyone, management for staff
    match /product-galleries/{galleryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // --- ORDERS & TRANSACTIONS ---
    // Orders: Creation enabled for guests, management for authenticated staff
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isAuthenticated();
      allow delete: if false;
    }

    // --- QUOTATIONS ---
    // Management for authenticated staff
    match /quotations/{quotationId} {
      allow read, write: if isAuthenticated();
    }

    // --- ADMINISTRATIVE DATA ---
    // Operations: Protected administrative data
    match /customers/{customerId} { allow read, write: if isAuthenticated(); }
    match /inventory/{itemId} { allow read, write: if isAuthenticated(); }
    match /distributors/{distributorId} { allow read, write: if isAuthenticated(); }
    match /recipes/{recipeId} { allow read, write: if isAuthenticated(); }
    match /vendors/{vendorId} { allow read, write: if isAuthenticated(); }
    match /material-purchases/{purchaseId} { allow read, write: if isAuthenticated(); }
    match /costings/{costingId} { allow read, write: if isAuthenticated(); }

    // --- SYSTEM FALLBACK ---
    // Require authentication for everything else
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
