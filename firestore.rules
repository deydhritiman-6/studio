rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Security Rules for Roseberry Ops
    
    // Products: Catalog visible to everyone (including anonymous guests)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Orders: Creation enabled for guests, management for authenticated staff
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isAuthenticated();
      allow delete: if false;
    }

    // Operations: Protected administrative data
    match /customers/{customerId} { allow read, write: if isAuthenticated(); }
    match /inventory/{itemId} { allow read, write: if isAuthenticated(); }
    match /distributors/{distributorId} { allow read, write: if isAuthenticated(); }
    match /recipes/{recipeId} { allow read, write: if isAuthenticated(); }

    // Fallback: Require authentication for everything else
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}