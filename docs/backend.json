
{
  "entities": {
    "Ingredient": {
      "title": "Ingredient",
      "description": "A professional-grade artisan chocolate ingredient specification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "brand": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "origin": { "type": "string" },
        "defaultUnit": { "type": "string", "enum": ["mg", "g", "kg", "ml", "L", "pcs", "tbsp", "tsp", "pinch"] },
        "cocoaPercent": { "type": "number" },
        "fatPercent": { "type": "number" },
        "moisturePercent": { "type": "number" },
        "brix": { "type": "number" },
        "ph": { "type": "number" },
        "functionalRoles": { "type": "array", "items": { "type": "string" } },
        "allergens": {
          "type": "object",
          "properties": {
            "milk": { "type": "string" },
            "egg": { "type": "string" },
            "treeNuts": { "type": "string" },
            "peanuts": { "type": "string" },
            "soy": { "type": "string" },
            "wheat": { "type": "string" },
            "vegan": { "type": "boolean" },
            "glutenFree": { "type": "boolean" }
          }
        },
        "storageCondition": { "type": "string" },
        "shelfLifeDays": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isFavourite": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "defaultUnit"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "A professional chocolate recipe with versioning.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "associatedProductId": { "type": "string" },
        "productName": { "type": "string" },
        "currentVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Testing", "Approved", "Published", "Archived"] },
        "batchSize": { "type": "number" },
        "batchUnit": { "type": "string" },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredientId": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" },
              "percentage": { "type": "number" },
              "order": { "type": "number" }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "instructions": { "type": "string" },
              "temperature": { "type": "number" },
              "order": { "type": "number" }
            }
          }
        },
        "allergens": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "status", "batchSize"]
    },
    "Facility": {
      "title": "Facility",
      "description": "An internal Roseberry facility showcase item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "caption": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "showOnHomepage": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Customer feedback and artisan experiences.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "language": { "type": "string" },
        "testimonial": { "type": "string" },
        "rating": { "type": "number" },
        "photoUrl": { "type": "string" },
        "occasion": { "type": "string" },
        "product": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "approvedAt": { "type": "string" }
      },
      "required": ["name", "city", "country", "testimonial", "rating", "status"]
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global website configuration including footer data.",
      "type": "object",
      "properties": {
        "brand": { "type": "object" },
        "address": { "type": "object" },
        "contact": { "type": "object" },
        "hours": { "type": "object" },
        "legal": { "type": "object" },
        "bank": { "type": "object" },
        "maps": { "type": "object" },
        "social": { "type": "object" },
        "links": { "type": "array" },
        "policies": { "type": "array" },
        "visibility": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "ChocolatierSettings": {
      "title": "Chocolatier Settings",
      "description": "Dynamic profile for the master chocolatier.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "description": { "type": "string" },
        "quote": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isVisible": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/ingredients/{ingredientId}": {
      "schema": "#/backend/entities/Ingredient",
      "description": "Master intelligence library of artisan components."
    },
    "/recipes/{recipeId}": {
      "schema": "#/backend/entities/Recipe",
      "description": "Collection of professional chocolate formulations."
    },
    "/facilities/{facilityId}": {
      "schema": "#/backend/entities/Facility",
      "description": "Artisan facility profiles."
    },
    "/testimonials/{testimonialId}": {
      "schema": "#/backend/entities/Testimonial",
      "description": "Customer reviews and patron stories."
    },
    "/settings/{settingId}": {
      "schema": "#/backend/entities/SiteSettings",
      "description": "Global configuration settings."
    },
    "/siteContent/chocolatier": {
      "schema": "#/backend/entities/ChocolatierSettings",
      "description": "Artisan chocolatier profile data."
    }
  }
}
