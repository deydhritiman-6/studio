
{
  "entities": {
    "Ingredient": {
      "title": "Ingredient",
      "description": "A master ingredient in the library.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "description": { "type": "string" },
        "defaultUnit": { "type": "string", "enum": ["mg", "g", "kg", "ml", "L", "pcs", "tbsp", "tsp", "pinch"] },
        "density": { "type": "number", "description": "g/ml for volume-to-weight conversions" },
        "allergens": { "type": "array", "items": { "type": "string" } },
        "purchasePrice": { "type": "number" },
        "purchaseQuantity": { "type": "number" },
        "purchaseUnit": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isFavourite": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "defaultUnit"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "A professional chocolate recipe with versioning.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "associatedProductId": { "type": "string" },
        "productName": { "type": "string" },
        "chocolateType": { "type": "string" },
        "currentVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Testing", "Approved", "Published", "Archived"] },
        "difficulty": { "type": "string", "enum": ["Easy", "Intermediate", "Professional", "Master"] },
        "prepTime": { "type": "number" },
        "processTime": { "type": "number" },
        "batchSize": { "type": "number" },
        "batchUnit": { "type": "string" },
        "yield": { "type": "number" },
        "yieldUnit": { "type": "string" },
        "shortDescription": { "type": "string" },
        "detailedDescription": { "type": "string" },
        "internalNotes": { "type": "string" },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredientId": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" },
              "percentage": { "type": "number" },
              "preparation": { "type": "string" },
              "stage": { "type": "string" },
              "notes": { "type": "string" },
              "order": { "type": "number" }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "instructions": { "type": "string" },
              "temperature": { "type": "number" },
              "tempUnit": { "type": "string", "enum": ["C", "F"] },
              "time": { "type": "number" },
              "equipment": { "type": "string" },
              "order": { "type": "number" }
            }
          }
        },
        "allergens": { "type": "array", "items": { "type": "string" } },
        "totalCost": { "type": "number" },
        "costPer100g": { "type": "number" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "status", "batchSize"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "A supplier for ingredients and materials.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "status"]
    },
    "MaterialPurchase": {
      "title": "Material Purchase",
      "description": "A record of purchasing raw materials or ingredients.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Ordered", "Received", "Cancelled"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredientId": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" },
              "price": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["purchaseDate", "vendorId", "totalAmount"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/ingredients/{ingredientId}": {
      "schema": "#/backend/entities/Ingredient",
      "description": "Master library of artisan ingredients."
    },
    "/recipes/{recipeId}": {
      "schema": "#/backend/entities/Recipe",
      "description": "Collection of professional chocolate recipes."
    },
    "/customers/{customerId}": {
      "schema": "#/backend/entities/Customer",
      "description": "Collection of customer profiles."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserAccount",
      "description": "Collection of staff user accounts."
    },
    "/orders/{orderId}": {
      "schema": "#/backend/entities/Order",
      "description": "Collection of customer orders."
    },
    "/products/{productId}": {
      "schema": "#/backend/entities/Product",
      "description": "Collection of chocolate products."
    },
    "/inventory/{itemId}": {
      "schema": "#/backend/entities/InventoryItem",
      "description": "Collection of inventory items."
    },
    "/distributors/{distributorId}": {
      "schema": "#/backend/entities/Distributor",
      "description": "Collection of distributors."
    },
    "/quotations/{quotationId}": {
      "schema": "#/backend/entities/Quotation",
      "description": "Collection of customer quotations."
    },
    "/vendors/{vendorId}": {
      "schema": "#/backend/entities/Vendor",
      "description": "Collection of material suppliers."
    },
    "/material-purchases/{purchaseId}": {
      "schema": "#/backend/entities/MaterialPurchase",
      "description": "Collection of raw material purchase records."
    }
  }
}
