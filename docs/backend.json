
{
  "entities": {
    "Ingredient": {
      "title": "Ingredient",
      "description": "A professional-grade artisan chocolate ingredient specification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "brand": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "origin": { "type": "string" },
        "defaultUnit": { "type": "string", "enum": ["mg", "g", "kg", "ml", "L", "pcs", "tbsp", "tsp", "pinch"] },
        "cocoaPercent": { "type": "number" },
        "fatPercent": { "type": "number" },
        "moisturePercent": { "type": "number" },
        "brix": { "type": "number" },
        "ph": { "type": "number" },
        "functionalRoles": { "type": "array", "items": { "type": "string" } },
        "allergens": {
          "type": "object",
          "properties": {
            "milk": { "type": "string" },
            "egg": { "type": "string" },
            "treeNuts": { "type": "string" },
            "peanuts": { "type": "string" },
            "soy": { "type": "string" },
            "wheat": { "type": "string" },
            "vegan": { "type": "boolean" },
            "glutenFree": { "type": "boolean" }
          }
        },
        "storageCondition": { "type": "string" },
        "shelfLifeDays": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isFavourite": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "defaultUnit"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "A professional chocolate recipe with versioning.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "associatedProductId": { "type": "string" },
        "productName": { "type": "string" },
        "currentVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Testing", "Approved", "Published", "Archived"] },
        "batchSize": { "type": "number" },
        "batchUnit": { "type": "string" },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredientId": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" },
              "percentage": { "type": "number" },
              "order": { "type": "number" }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "instructions": { "type": "string" },
              "temperature": { "type": "number" },
              "order": { "type": "number" }
            }
          }
        },
        "allergens": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "status", "batchSize"]
    },
    "Facility": {
      "title": "Facility",
      "description": "An internal Roseberry facility showcase item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "caption": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "showOnHomepage": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "FacilitiesPageSettings": {
      "title": "Facilities Page Settings",
      "description": "Configuration for the Inside Roseberry showcase.",
      "type": "object",
      "properties": {
        "eyebrowText": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "heroImageUrl": { "type": "string" },
        "homepageTitle": { "type": "string" },
        "homepageSubtitle": { "type": "string" },
        "homepageDescription": { "type": "string" },
        "homepageButtonText": { "type": "string" },
        "homepageButtonEnabled": { "type": "boolean" },
        "bottomStatement": { "type": "string" },
        "bottomDescription": { "type": "string" },
        "logoUrl": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/ingredients/{ingredientId}": {
      "schema": "#/backend/entities/Ingredient",
      "description": "Master intelligence library of artisan components."
    },
    "/recipes/{recipeId}": {
      "schema": "#/backend/entities/Recipe",
      "description": "Collection of professional chocolate formulations."
    },
    "/facilities/{facilityId}": {
      "schema": "#/backend/entities/Facility",
      "description": "Artisan facility profiles."
    },
    "/settings/facilities": {
      "schema": "#/backend/entities/FacilitiesPageSettings",
      "description": "Global settings for the facilities showcase."
    }
  }
}
